<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>SliceForge.Cli</PackageId>
    <Title>SliceForge CLI</Title>
    <Description>Command-line experience for creating and checking SliceForge applications.</Description>
    <PackageTags>sliceforge cli dotnet-tool templates</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sliceforge</ToolCommandName>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SliceForge.Cli.Tests" />
  </ItemGroup>

</Project>
