<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SliceForge.Observability</PackageId>
    <Description>Optional logging, tracing, and metrics instrumentation for SliceForge messaging.</Description>
    <PackageTags>sliceforge;observability;logging;tracing;metrics</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="..\SliceForge.Runtime\SliceForge.Runtime.csproj" />
  </ItemGroup>

</Project>
