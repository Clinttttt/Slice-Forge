<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SliceForge.Observability</PackageId>
    <Description>Structured logging, tracing, activities, and metrics for SliceForge command and query execution.</Description>
    <PackageTags>sliceforge;dotnet;observability;logging;tracing;metrics;diagnostics;vertical-slice</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="..\SliceForge.Runtime\SliceForge.Runtime.csproj" />
  </ItemGroup>

</Project>
