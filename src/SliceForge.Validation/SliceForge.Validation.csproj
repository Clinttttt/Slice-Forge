<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SliceForge.Validation</PackageId>
    <Description>FluentValidation integration for SliceForge command and query execution with automatic validation and structured Result failures.</Description>
    <PackageTags>sliceforge;dotnet;vertical-slice;validation;fluentvalidation;cqrs;result-pattern</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="..\SliceForge.Runtime\SliceForge.Runtime.csproj" />
  </ItemGroup>

</Project>
