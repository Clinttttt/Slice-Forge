<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SliceForge.Validation</PackageId>
    <Description>Optional FluentValidation sender decorator for SliceForge.</Description>
    <PackageTags>sliceforge;validation;fluentvalidation</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="..\SliceForge.Runtime\SliceForge.Runtime.csproj" />
  </ItemGroup>

</Project>
