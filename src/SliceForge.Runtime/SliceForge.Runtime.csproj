<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="..\SliceForge.Core\SliceForge.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SliceForge.Runtime</PackageId>
    <Description>Explicit command and query dispatch for SliceForge with typed handlers, cancellation support, and no mandatory mediator dependency.</Description>
    <PackageTags>sliceforge;dotnet;vertical-slice;cqrs;messaging;commands;queries;dispatcher;dependency-injection</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

</Project>
