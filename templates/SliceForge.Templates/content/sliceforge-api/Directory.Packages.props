<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="SliceForge.Core" Version="0.1.0-preview.4" />
    <PackageVersion Include="SliceForge.Runtime" Version="0.1.0-preview.4" />
<!--#if (UseValidation) -->
    <PackageVersion Include="SliceForge.Validation" Version="0.1.0-preview.4" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
<!--#endif -->
    <PackageVersion Include="SliceForge.AspNetCore" Version="0.1.0-preview.4" />
<!--#if (UseObservability) -->
    <PackageVersion Include="SliceForge.Observability" Version="0.1.0-preview.4" />
<!--#endif -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
