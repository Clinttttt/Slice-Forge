<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>SliceForge.Templates</PackageId>
    <PackageType>Template</PackageType>
    <Title>SliceForge Templates</Title>
    <Description>Opinionated .NET 10 Minimal API template using SliceForge Vertical Slice architecture, validation, observability, and testing.</Description>
    <PackageTags>sliceforge;vertical-slice;dotnet;dotnet-new;templates;scaffolding;aspnetcore;minimal-api;testing</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- The content-only template intentionally has no lib/ref assembly target. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content/**/*"
             Exclude="content/**/bin/**;content/**/obj/**"
             Pack="true"
             PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
